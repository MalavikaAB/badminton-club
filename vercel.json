{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "node_modules/postgres/**"
    }
  },
  "rewrites": [
    { "source": "/api/club-night", "destination": "/api/index" },
    { "source": "/api/club-night/:path*", "destination": "/api/index?path=club-night/:path*" }
  ]
}
